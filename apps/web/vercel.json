{
  "framework": "vite",
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @ayurplex/web build",
  "outputDirectory": "dist",
  "installCommand": "echo 'skip - handled in buildCommand'",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
